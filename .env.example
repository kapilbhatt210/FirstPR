# FirstPR — Environment Variables Template
# Copy this file to .env.local for local development.
# WARNING: Never commit actual API keys, personal access tokens, or credentials to version control.

# GitHub API Configuration (Optional in development; recommended for private repo inspection or higher rate limits)
# GITHUB_TOKEN=your_github_personal_access_token_here

# AI Provider Configuration (Gemma 4 via Google AI / Vertex endpoint)
# Never expose these keys to browser code (keep server-side only).
# GEMMA_API_KEY=your_gemma_api_key_here
# GEMMA_MODEL_NAME=gemma-4-26b-a4b-it
# GEMMA_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models
# FIRSTPR_ENABLE_AI=false
